{
  "name": "yasmin-tarnow",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": "./.site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "build": { "command": "node scripts/build.mjs" },
  "vars": {
    "BOOKING_EMAIL": "paweltylko777@gmail.com",
    "MAIL_FROM": "powiadomienia@rezerwacje.yasmin-tarnow.pl",
    "BOOKINGS_ENABLED": "true",
    "PUBLIC_ORIGIN": "https://yasmin-tarnow.pl"
  },
  "send_email": [{ "name": "EMAIL", "destination_address": "paweltylko777@gmail.com" }],
  "observability": { "enabled": true, "redact_query_string": true },
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yasmin-bookings",
      "database_id": "075c9b88-f3ad-433f-8720-9f135432c5a3",
      "migrations_dir": "./migrations"
    }
  ]
}

